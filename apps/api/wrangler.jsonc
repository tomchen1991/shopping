{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "order-room-api",
  "main": "src/index.js",
  "compatibility_date": "2026-04-01",
  "send_metrics": false,
  "vars": {
    "WEB_ORIGIN": "http://127.0.0.1:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "order-room",
      // Local placeholder. Replace with the actual database ID before deployment.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COVERS",
      "bucket_name": "order-room-covers"
    }
  ]
}
